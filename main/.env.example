# Set these in your shell before starting Flask; this file contains no secrets.
# Use a stable random value so sessions remain valid after a server restart.
STUDENTS_SPACE_SECRET_KEY=replace-with-a-long-random-secret

# Used only to create the first ADMIN row when the ADMIN table is empty.
STUDENTS_SPACE_ADMIN_NAME=
STUDENTS_SPACE_ADMIN_EMAIL=
STUDENTS_SPACE_ADMIN_PASSWORD=
